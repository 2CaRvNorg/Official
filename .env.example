# =============================================================================
# 2Carvn Academy - Supabase Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your Supabase project credentials.
# Get these from your Supabase Dashboard:
#   https://supabase.com/dashboard -> Select Project -> Settings -> API
# =============================================================================

# Your Supabase project URL (includes the API endpoint)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anon (public) API key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================================================
# OPTIONAL: For server-side operations (admin scripts, background jobs)
# These are used in API routes and server components, NOT exposed to browser
# =============================================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# =============================================================================
# Local Development Notes:
# =============================================================================
# 1. Create a Supabase project at https://supabase.com
# 2. Run the migration: supabase/migrations/20261111_master_schema.sql
# 3. Run the seed: supabase/seed_super_admin.sql (creates admin@2carvn.academy)
# 4. Copy .env.example to .env.local and fill in the values above
# 5. Run: npm run dev
# 6. Login at /login with:
#    Email: admin@2carvn.academy
#    Password: Admin@2Carvn2026
# =============================================================================
